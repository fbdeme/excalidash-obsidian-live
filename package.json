    "test": "node scripts/verify-compressed-json.mjs && node scripts/verify-collection-resolution.mjs",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "dependencies": {
    "@codemirror/state": "6.5.0",
